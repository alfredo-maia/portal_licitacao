generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  DIRETORIA
  ANALISTA_COMERCIAL
  OPERADOR
}

enum LicitacaoStatus {
  PENDENTE
  ACEITA
  RECUSADA
  ANALISE_TECNICA
  ANALISE_FINANCEIRA
  REVISAO_PROPOSTA
  ENVIADA
  EM_DISPUTA
  AGUARDANDO_RESULTADO
  CONTEMPLADA
  IMPUGNADA
  NAO_CONTEMPLADA_PRECO
  NAO_CONTEMPLADA_DOCUMENTACAO
  NAO_CONTEMPLADA_DESISTENCIA
  REVOGADA_ANULADA
}

enum ParecerIA {
  GO
  AVALIAR
  NO_GO
}

enum NotificacaoTipo {
  N1_COLETA_CONCLUIDA
  N2_LICITACAO_ATUALIZADA
  N3_ABERTURA_AMANHA
  N4_PRESENCIAL_PROXIMA
  N5_PENDENTE_CRITICA
  N6_VENCIMENTO_PORTAL
  N7_VENCIMENTO_DOCUMENTO
  N8_PRAZO_IMPUGNACAO
  N9_MENCAO_NOTA
  N10_MOVIMENTACAO_LICITACAO
  N11_RELATORIO_IA_PRONTO
}

enum NotificacaoSeveridade {
  INFO
  ATENCAO
  CRITICA
}

enum PortalStatus {
  NAO_CADASTRADO
  PRE_CADASTRO
  AGUARDANDO_APROVACAO
  CADASTRADO
  REJEITADO
  VENCIDO
  SUSPENSO
}

enum PortalPeriodicidade {
  MENSAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
  GRATUITO
}

enum DocumentoCategoria {
  JURIDICA
  FISCAL_TRABALHISTA
  QUALIFICACAO_TECNICA
  QUALIFICACAO_ECONOMICA
  OUTROS
}

enum DocumentoStatus {
  ATIVO
  ARQUIVADO
  SUBSTITUIDO
}

enum PlanoAssinatura {
  BASICO
  PRO
  ENTERPRISE
}

enum TenantRole {
  TITULAR
  MEMBRO
  CONSULTOR
}

model User {
  id                         String                     @id @default(cuid())
  name                       String
  email                      String                     @unique
  passwordHash               String
  role                       Role                       @default(OPERADOR)
  ativo                      Boolean                    @default(true)
  isSuperAdmin               Boolean                    @default(false)
  cpf                        String?
  telefone                   String?
  cep                        String?
  logradouro                 String?
  numero                     String?
  complemento                String?
  bairro                     String?
  cidade                     String?
  uf                         String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  accounts                   Account[]
  sessions                   Session[]
  auditLogs                  AuditLog[]
  licitacoesResponsavel      Licitacao[]                @relation("LicitacaoResponsavel")
  licitacoesAtribuido        LicitacaoAtribuido[]
  notificacoesRecebidas      NotificacaoDestinatario[]
  statusAlterados            LicitacaoStatusHistorico[]
  documentosCriados          Documento[]
  impugnacoesCriadas         Impugnacao[]
  tenantMemberships          TenantUser[]
  tenantConvitesCriados      TenantConvite[]            @relation("ConvitesCriados")
  tenantLicitacoesResponsavel TenantLicitacao[]          @relation("TenantLicitacaoResponsavel")

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Licitacao {
  id                    String                      @id @default(cuid())
  idPncp                String                      @unique
  numeroEdital          String
  orgaoNome             String
  orgaoCnpj             String
  uf                    String                      @db.VarChar(2)
  municipio             String?
  esfera                String?
  poder                 String?
  modalidade            String
  portalDisputa         String?
  miniResumo            String
  resumo                String                      @db.Text
  valorEstimado         Float
  dataAbertura          DateTime
  dataEncerramentoProposta DateTime?
  dataPublicacaoPncp    DateTime?
  dataUltimaAtualizacao DateTime?
  status                LicitacaoStatus             @default(PENDENTE)
  parecerIA             ParecerIA                   @default(AVALIAR)
  justificativaIA       String?                     @db.Text
  tipoSistemaCodigo     String?
  atestadosExigidos     Json?
  motivoRecusa          String?                     @db.Text
  quantidadeLotes       Int                         @default(1)
  loteUnico             Boolean                     @default(true)
  precoPorLote          Boolean                     @default(false)
  isPresencial          Boolean                     @default(false)
  distanciaGoianiaKm    Int?
  linkPncp              String?
  linkSistemaOrigem     String?
  hashCritico           String?
  valorArrematado       Float?
  responsavelId         String?
  responsavel           User?                       @relation("LicitacaoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  atribuidos            LicitacaoAtribuido[]
  arquivos              Arquivo[]
  repositoriosSimilares RepositorioSimilar[]
  analisesIA            AnaliseStatusParticipacao[]
  notas                 LicitacaoNota[]
  historicoStatus       LicitacaoStatusHistorico[]
  notificacoes          Notificacao[]
  modalidadeCodigo      Int?
  numeroControlePNCP    String?
  segmentoMacro         String?
  subcategorias         Json?
  impugnacoes           Impugnacao[]
  tenantLicitacoes      TenantLicitacao[]
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@index([dataAbertura])
  @@index([status])
  @@index([idPncp])
  @@index([tipoSistemaCodigo])
  @@index([segmentoMacro])
  @@index([modalidadeCodigo])
  @@index([createdAt])
}

model TipoSistema {
  id        String   @id @default(cuid())
  codigo    String   @unique
  nome      String
  ordem     Int
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ordem])
  @@index([ativo])
}

model AuditLog {
  id           String   @id @default(cuid())
  ocorridoEm   DateTime @default(now())
  usuarioId    String?
  usuarioNome  String?
  ip           String?
  acao         String
  entidadeTipo String
  entidadeId   String
  antes        Json?
  depois       Json?
  usuario      User?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([entidadeTipo, entidadeId])
  @@index([ocorridoEm])
  @@index([tenantId])
  @@map("audit_log")
}

model LicitacaoAtribuido {
  id          String   @id @default(cuid())
  licitacaoId String
  usuarioId   String
  criadoEm    DateTime @default(now())

  licitacao Licitacao @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)
  usuario   User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([licitacaoId, usuarioId])
  @@index([licitacaoId])
  @@index([usuarioId])
  @@map("licitacao_atribuido")
}

model Arquivo {
  id          String    @id @default(cuid())
  licitacaoId String?
  tenantId    String?
  nome        String
  tamanho     Int
  mimeType    String
  caminho     String
  r2Key       String?
  r2Url       String?
  cachedAt    DateTime?
  criadoEm    DateTime  @default(now())

  licitacao Licitacao? @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)
  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([licitacaoId])
  @@index([tenantId])
  @@index([r2Key])
  @@map("arquivo")
}

model RepositorioSimilar {
  id          String   @id @default(cuid())
  licitacaoId String
  nome        String
  url         String
  criadoEm    DateTime @default(now())

  licitacao Licitacao @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)

  @@index([licitacaoId])
  @@map("repositorio_similar")
}

model AnaliseStatusParticipacao {
  id             String   @id @default(cuid())
  licitacaoId    String
  scriptPrompt   String   @db.Text
  relatorioTexto String   @db.Text
  impedimentos   Json?
  viabilidade    Json?
  custos         Json?
  precoSugerido  Json?
  executadoPorId String?
  criadoEm       DateTime @default(now())

  // Issue #36 — análise assíncrona (LLM + cruzamento interno), cota mensal por tenant e relatório em PDF
  tenantId       String?
  status         String    @default("CONCLUIDO")
  origem         String?
  parecer        String?
  relatorioJson  Json?
  pdfBase64      String?   @db.Text
  pdfNome        String?
  erroMensagem   String?
  concluidoEm    DateTime?

  licitacao Licitacao @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)

  @@index([licitacaoId])
  @@index([tenantId, criadoEm])
  @@map("analise_status_participacao")
}

// Issue #36 — Notas colaborativas do Dossiê (aba "Notas") com @menções
model LicitacaoNota {
  id             String   @id @default(cuid())
  licitacaoId    String
  tenantId       String?
  autorId        String
  autorNome      String
  autorCargo     String   @default("")
  texto          String   @db.Text
  mencionadosIds String[] @default([])
  editada        Boolean  @default(false)
  criadaEm       DateTime @default(now())
  atualizadaEm   DateTime @default(now()) @updatedAt

  licitacao Licitacao @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)

  @@index([licitacaoId, criadaEm])
  @@index([tenantId])
  @@map("licitacao_nota")
}

model LicitacaoStatusHistorico {
  id             String           @id @default(cuid())
  licitacaoId    String
  statusAnterior LicitacaoStatus?
  statusNovo     LicitacaoStatus
  motivo         String?          @db.Text
  usuarioId      String?
  ocorridoEm     DateTime         @default(now())

  licitacao Licitacao @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)
  usuario   User?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([licitacaoId, ocorridoEm])
  @@index([statusNovo, ocorridoEm])
  @@map("licitacao_status_historico")
}

model Notificacao {
  id                String                @id @default(cuid())
  tipo              NotificacaoTipo
  titulo            String
  descricao         String                @db.Text
  severidade        NotificacaoSeveridade @default(INFO)
  linkDestino       String?
  licitacaoId       String?
  chaveIdempotencia String                @unique
  criadaEm          DateTime              @default(now())

  licitacao     Licitacao?                @relation(fields: [licitacaoId], references: [id], onDelete: SetNull)
  destinatarios NotificacaoDestinatario[]

  @@index([criadaEm])
  @@index([tipo])
  @@index([licitacaoId])
  @@map("notificacao")
}

model NotificacaoDestinatario {
  id            String    @id @default(cuid())
  notificacaoId String
  usuarioId     String
  lidaEm        DateTime?
  criadoEm      DateTime  @default(now())

  notificacao Notificacao @relation(fields: [notificacaoId], references: [id], onDelete: Cascade)
  usuario     User        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([notificacaoId, usuarioId])
  @@index([usuarioId, lidaEm])
  @@index([notificacaoId])
  @@map("notificacao_destinatario")
}

model Portal {
  id                      String              @id @default(cuid())
  nome                    String
  url                     String
  status                  PortalStatus        @default(NAO_CADASTRADO)
  login                   String?
  email                   String?
  cnpj                    String?
  usuario                 String?
  valorAssinatura         Float?
  periodicidade           PortalPeriodicidade @default(ANUAL)
  dataVencimento          DateTime?
  aceitaRobo              Boolean             @default(false)
  exigeCertificadoDigital Boolean             @default(false)
  suporteContato          String?
  observacoes             String?             @db.Text
  tenantId                String?
  tenant                  Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  criadoEm                DateTime            @default(now())
  atualizadoEm            DateTime            @updatedAt

  @@index([status])
  @@index([dataVencimento])
  @@index([tenantId])
  @@map("portal")
}

model Documento {
  id             String             @id @default(cuid())
  nome           String
  categoria      DocumentoCategoria
  tipo           String?
  orgaoEmissor   String?
  semValidade    Boolean            @default(false)
  dataEmissao    DateTime?
  dataVencimento DateTime?
  arquivoUrl     String?
  arquivoNome    String?
  arquivoTamanho Int?
  mimeType       String?
  versao         Int                @default(1)
  documentoPaiId String?
  status         DocumentoStatus    @default(ATIVO)
  validacaoStatus    String?        @default("NAO_VERIFICADO")
  validacaoResumo    String?        @db.Text
  cnpjExtraido       String?
  emissaoExtraida    String?
  vencimentoExtraido String?
  tipoDetectado      String?
  validadoEm         DateTime?
  criadoPorId    String?
  criadoEm       DateTime           @default(now())
  atualizadoEm   DateTime           @updatedAt

  documentoPai       Documento?  @relation("HistoricoVersoes", fields: [documentoPaiId], references: [id], onDelete: SetNull)
  versoesAnteriores  Documento[] @relation("HistoricoVersoes")
  criadoPor          User?       @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  tenantId           String?
  tenant             Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([categoria, status])
  @@index([dataVencimento])
  @@index([documentoPaiId])
  @@index([tenantId])
  @@map("documento")
}

// Sprint 5 — Impugnações e Esclarecimentos (PRD §4.9 / Art. 164 Lei 14.133/2021)
enum ImpugnacaoStatus {
  RASCUNHO
  PROTOCOLADA
  ACATADA
  INDEFERIDA
}

model Impugnacao {
  id                 String           @id @default(cuid())
  licitacaoId        String?
  tenantId           String?
  numeroEdital       String
  orgaoNome          String
  objeto             String?          @db.Text
  status             ImpugnacaoStatus @default(RASCUNHO)
  motivoLegal        String
  dataAberturaSessao DateTime
  prazoFatal         DateTime
  fundamentacao      String           @db.Text
  pedidos            String           @db.Text
  numeroProtocolo    String?
  dataProtocolo      DateTime?
  dataResposta       DateTime?
  decisaoJulgamento  String?          @db.Text
  criadoPorId        String?
  criadoEm           DateTime         @default(now())
  atualizadoEm       DateTime         @updatedAt

  licitacao Licitacao? @relation(fields: [licitacaoId], references: [id], onDelete: SetNull)
  criadoPor User?      @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([prazoFatal])
  @@index([licitacaoId])
  @@map("impugnacao")
}

// Sprint 6 — Configurações Corporativas (PRD §4.11 / Anexo 4)
model ConfiguracaoEmpresa {
  id                 String   @id @default("default")
  razaoSocial        String   @default("APONTA TECNOLOGIA E SERVICOS LTDA")
  nomeFantasia       String?
  cnpj               String   @default("12.345.678/0001-90")
  inscricaoEstadual  String?
  inscricaoMunicipal String?
  cnae               String?
  cnaesSecundarios   String[] @default([])
  endereco           String   @default("Av. República do Líbano, 1200, Setor Oeste")
  numero             String?
  complemento        String?
  bairro             String?
  cidade             String   @default("Goiânia")
  uf                 String   @default("GO")
  cep                String   @default("74115-030")
  representanteNome  String   @default("Vítor Henrique de Souza")
  representanteCpf   String   @default("123.456.789-00")
  representanteRg    String?
  representanteCargo String   @default("Sócio-Administrador")
  bancoNome          String?  @default("Banco do Brasil")
  agencia            String?  @default("1234-5")
  contaCorrente      String?  @default("98765-4")
  chavePix           String?  @default("12.345.678/0001-90")
  logoUrl            String?  @db.Text
  papelTimbradoUrl   String?  @db.Text
  tenantId           String?  @unique
  tenant             Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  preferenciasUpdatedAt DateTime?
  atualizadoEm       DateTime @default(now()) @updatedAt

  @@map("configuracao_empresa")
}

enum TenantBillingStatus {
  TRIAL
  ATIVO
  GRACE_PERIOD
  BLOQUEADO
  CANCELADO
}

// Sprint SaaS 1 — Multi-Tenant, Schemas por CNPJ & Isolamento de Dados (PRD §3 / ADR 0007 / Issue #9)
model Tenant {
  id                  String              @id @default(cuid())
  cnpj                String              @unique
  razaoSocial         String
  nomeFantasia        String?
  cnaePrincipal       String?
  cnaesSecundarios    String[]            @default([])
  endereco            String?
  cidade              String?
  uf                  String?             @db.VarChar(2)
  plano               PlanoAssinatura     @default(BASICO)
  billingStatus       TenantBillingStatus @default(TRIAL)
  storageExtraQuotaMb Int                 @default(0)
  asaasCustomerId     String?
  asaasSubscriptionId String?
  vencimentoAssinatura DateTime?
  ultimoPagamentoEm   DateTime?
  maxCnpjs            Int                 @default(1)
  maxUsers            Int                 @default(1)
  ativo               Boolean             @default(true)
  telefone            String?
  segmentos           String[]            @default([])
  subsegmentos        String[]            @default([])
  ufs                 String[]            @default([])
  brasilInteiro       Boolean             @default(true)
  preferenciasUpdatedAt DateTime?
  trialFim            DateTime?
  criadoEm            DateTime            @default(now())
  atualizadoEm        DateTime            @updatedAt

  users         TenantUser[]
  licitacoes    TenantLicitacao[]
  convites      TenantConvite[]
  documentos    Documento[]
  portais       Portal[]
  arquivos      Arquivo[]
  configuracao  ConfiguracaoEmpresa?
  impugnacoes   Impugnacao[]
  auditLogs     AuditLog[]
  precosSalvos  TenantPrecoSalvo[]
  supportTickets SupportTicket[]

  @@index([cnpj])
  @@index([plano])
  @@map("tenant")
}

model TenantUser {
  id       String     @id @default(cuid())
  tenantId String
  userId   String
  role     TenantRole @default(MEMBRO)
  ativo    Boolean    @default(true)
  criadoEm DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
  @@map("tenant_user")
}

model TenantLicitacao {
  id            String          @id @default(cuid())
  tenantId      String
  licitacaoId   String
  statusKanban  LicitacaoStatus @default(PENDENTE)
  tags          String[]        @default([])
  notas         String?         @db.Text
  lanceMinimo   Float?
  valorProposta Float?
  valorHomologado Float?
  motivoRecusa  String?         @db.Text
  dataDecisao   DateTime?
  responsavelId String?
  calculadoraDados Json?
  criadoEm      DateTime        @default(now())
  atualizadoEm  DateTime        @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  licitacao   Licitacao @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)
  responsavel User?     @relation("TenantLicitacaoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)

  @@unique([tenantId, licitacaoId])
  @@index([tenantId, statusKanban])
  @@index([licitacaoId])
  @@map("tenant_licitacao")
}

model TenantConvite {
  id          String     @id @default(cuid())
  tenantId    String
  email       String
  role        TenantRole @default(MEMBRO)
  token       String     @unique
  expiraEm    DateTime
  aceitoEm    DateTime?
  criadoPorId String
  criadoEm    DateTime   @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  criadoPor User   @relation("ConvitesCriados", fields: [criadoPorId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([token])
  @@index([email])
  @@map("tenant_convite")
}

// Sprint SaaS 4 — Idempotência de Webhooks Asaas (PRD §6 / ADR 0010)
model AsaasWebhookEvent {
  id           String    @id
  evento       String
  tenantId     String?
  payload      Json?
  processado   Boolean   @default(false)
  processadoEm DateTime?
  criadoEm     DateTime  @default(now())

  @@index([evento])
  @@index([processado])
  @@index([criadoEm])
  @@map("asaas_webhook_event")
}

// Sprint SaaS 4 — Fila de WhatsApp com Jitter Humano Anti-Ban (PRD §7 / ADR 0010)
enum WhatsAppStatus {
  PENDENTE
  ENVIANDO
  ENVIADO
  FALHA
  PAUSADO_OPT_OUT
}

model WhatsAppMensagem {
  id             String         @id @default(cuid())
  tenantId       String?
  destinatario   String
  mensagem       String         @db.Text
  tipo           String         @default("ALERTA")
  status         WhatsAppStatus @default(PENDENTE)
  tentativas     Int            @default(0)
  erro           String?
  jitterSegundos Int            @default(4)
  agendadoPara   DateTime       @default(now())
  enviadoEm      DateTime?
  criadoEm       DateTime       @default(now())

  @@index([status, agendadoPara])
  @@index([destinatario])
  @@map("whatsapp_mensagem")
}

model WhatsAppOptOut {
  id           String   @id @default(cuid())
  telefone     String   @unique
  motivo       String?  @default("Solicitação do usuário")
  criadoEm     DateTime @default(now())

  @@index([telefone])
  @@map("whatsapp_opt_out")
}

model TenantPrecoSalvo {
  id                  String   @id @default(cuid())
  tenantId            String
  nomeProduto         String
  termoPesquisado     String
  marcaReferencia     String?
  catmat              String?
  especificacaoResumo String?  @db.Text
  unidadeReferencia   String   @default("UN")
  ufFiltro            String   @default("TODOS")
  modalidadeFiltro    String   @default("TODOS")
  periodoMeses        Int      @default(12)
  quantidadeAmostras  Int      @default(0)
  precoMedio          Float    @default(0)
  mediana             Float    @default(0)
  menorPreco          Float    @default(0)
  maiorPreco          Float    @default(0)
  descontoMedio       Float    @default(0)
  faixaSugeridaMin    Float    @default(0)
  faixaSugeridaMax    Float    @default(0)
  observacoes         String?  @db.Text
  homologacoesJson    Json
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, criadoEm])
  @@index([tenantId, nomeProduto])
  @@map("tenant_preco_salvo")
}

// Bloco 1 (Issue #38) — Central de Suporte (FAB + Protocolos SuperADM-ready)
model SupportTicket {
  id            String                 @id @default(cuid())
  protocolo     String                 @unique
  tenantId      String?
  userId        String?
  autorNome     String
  autorEmail    String?
  autorTelefone String?
  categoria     String                 @default("DUVIDA")
  urgencia      String                 @default("MEDIA")
  assunto       String
  status        String                 @default("ABERTO")
  criadoEm      DateTime               @default(now())
  atualizadoEm  DateTime               @updatedAt
  concluidoEm   DateTime?

  tenant    Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  mensagens SupportTicketMessage[]

  @@index([tenantId, criadoEm])
  @@index([userId, criadoEm])
  @@index([status])
  @@map("support_ticket")
}

model SupportTicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  autorId   String?
  autorNome String
  autorTipo String   @default("CLIENTE")
  mensagem  String   @db.Text
  criadoEm  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, criadoEm])
  @@map("support_ticket_message")
}


